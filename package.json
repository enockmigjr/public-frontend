{
  "name": "public-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "contract:generate": "openapi-typescript contracts/openapi.public.json -o src/lib/api/schema.d.ts && prettier --write src/lib/api/schema.d.ts",
    "contract:hash": "node scripts/check-contract-hash.mjs",
    "contract:check": "pnpm contract:hash && pnpm contract:generate && git diff --exit-code -- src/lib/api/schema.d.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "5.2.2",
    "@tanstack/react-query": "5.90.20",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.71.2",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.1",
    "socket.io-client": "4.8.3",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "husky": "9.1.7",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.8.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
